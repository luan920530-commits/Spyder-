# Los hashes del modelo y su runtime se calculan sobre los bytes originales.
# Mantenerlos idénticos en cualquier sistema (incluidos checkouts con autocrlf).
models/minilm/*.json -text whitespace=cr-at-eol
models/minilm/tokenizer.json -diff
models/minilm/onnx/*.onnx binary
vendor/transformers/transformers.min.js -text -diff
vendor/transformers/*.wasm binary
# Los mapas y fuentes binarios de PDF.js deben conservarse sin conversión de línea.
vendor/pdfjs/cmaps/*.bcmap binary
vendor/pdfjs/standard_fonts/*.pfb binary
vendor/pdfjs/standard_fonts/*.ttf binary
# Licencias de terceros conservadas exactamente como se publicaron.
vendor/pdfjs/cmaps/LICENSE -text whitespace=-blank-at-eol,-blank-at-eof
vendor/pdfjs/standard_fonts/LICENSE* -text whitespace=-blank-at-eol,-blank-at-eof
tests/fixtures/*.pdf binary
